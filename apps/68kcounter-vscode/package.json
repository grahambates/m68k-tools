{
  "name": "68kcounter-vscode",
  "displayName": "68k Counter",
  "description": "68000 ASM source code cycle counter",
  "version": "1.3.0",
  "author": "Graham Bates <hello@grahambates.com>",
  "publisher": "gigabates",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/grahambates/68kcounter-vscode.git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "apps/68kcounter-vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:m68k",
    "onLanguage:vasmmot",
    "workspaceContains:**/*.{s,S,asm,ASM}"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "68kcounter.toggleCounts",
        "title": "68kcounter: Toggle counts"
      },
      {
        "command": "68kcounter.countSelection",
        "title": "68kcounter: Count selection"
      },
      {
        "command": "68kcounter.toggleCacheModel",
        "title": "68kcounter: Toggle cache timing model"
      },
      {
        "command": "68kcounter.resetCacheModel",
        "title": "68kcounter: Reset cache timing model to configured default"
      }
    ],
    "configuration": {
      "title": "68k Counter",
      "properties": {
        "68kcounter.defaultCpu": {
          "type": "string",
          "enum": [
            "68000",
            "68020",
            "68030",
            "68040",
            "68060"
          ],
          "default": "68000",
          "scope": "resource",
          "description": "Default timing CPU. Supported machine directives in the source override this setting."
        },
        "68kcounter.cacheModel": {
          "type": "string",
          "enum": [
            "worst",
            "cache"
          ],
          "enumDescriptions": [
            "Uncached timings (68020 worst case; 68030 average no-cache case).",
            "Cached instruction timings."
          ],
          "default": "worst",
          "scope": "resource",
          "description": "Default cache timing model for CPUs with cache timing data. Can be temporarily toggled per document for 68020/68030. Ignored for 68000; 68040/68060 always use cached reference costs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "pnpm --dir ../.. exec eslint apps/68kcounter-vscode",
    "package": "node ../../scripts/package-counter-extension.mjs",
    "publish": "node ../../scripts/package-counter-extension.mjs --publish",
    "build": "pnpm run compile",
    "typecheck": "tsc --noEmit",
    "test:extension-host": "pnpm run compile && pnpm run lint && node ../../scripts/package-counter-extension.mjs --stage-only && node ./out/test/runTest.js",
    "clean": "rm -rf out dist .tsbuild coverage",
    "test": "vitest run --config ../../vitest.package.config.mts --exclude 'src/test/**'"
  },
  "devDependencies": {
    "@types/debounce": "^1.2.0",
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.0.4",
    "@types/node": "22.18.0",
    "@types/vscode": "1.101.0",
    "glob": "^7.1.6",
    "mocha": "^8.2.1",
    "typescript": "5.9.3",
    "vscode-test": "^1.5.0",
    "@vscode/vsce": "^3.6.0"
  },
  "dependencies": {
    "68kcounter": "workspace:^",
    "debounce": "^1.2.1"
  },
  "private": true
}
