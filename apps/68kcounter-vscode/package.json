{
  "name": "68kcounter-vscode",
  "displayName": "68k Counter",
  "description": "68000 ASM source code cycle counter",
  "version": "1.2.0",
  "author": "Graham Bates <hello@grahambates.com>",
  "publisher": "gigabates",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/grahambates/68kcounter-vscode.git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "apps/68kcounter-vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:m68k",
    "onLanguage:vasmmot",
    "workspaceContains:**/*.{s,S,asm,ASM}"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "68kcounter.toggleCounts",
        "title": "68kcounter: Toggle counts"
      },
      {
        "command": "68kcounter.countSelection",
        "title": "68kcounter: Count selection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "pnpm --dir ../.. exec eslint apps/68kcounter-vscode",
    "test": "node ../../scripts/package-counter-extension.mjs --stage-only && node ./out/test/runTest.js",
    "package": "node ../../scripts/package-counter-extension.mjs"
  },
  "devDependencies": {
    "@types/debounce": "^1.2.0",
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.0.4",
    "@types/node": "22.18.0",
    "@types/vscode": "1.101.0",
    "glob": "^7.1.6",
    "mocha": "^8.2.1",
    "typescript": "5.9.3",
    "vscode-test": "^1.5.0",
    "@vscode/vsce": "^3.6.0"
  },
  "dependencies": {
    "68kcounter": "npm:68kcounter@^3.1.2",
    "debounce": "^1.2.1"
  },
  "private": true
}
