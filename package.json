{
  "name": "m68k-tools",
  "version": "0.11.3",
  "private": true,
  "description": "Motorola 68000 assembly libraries, command-line tools and editor applications",
  "license": "MIT",
  "author": "Graham Bates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/**' -r run build && pnpm --filter 68kcounter-vscode build && pnpm --filter 68kcounter-web build",
    "build:dev": "node scripts/build.mjs --sourcemap",
    "watch": "node scripts/build.mjs --sourcemap --watch",
    "clean": "pnpm -r run clean && rm -rf .staging coverage",
    "check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run check:no-lint-format",
    "check:no-lint-format": "pnpm run typecheck && pnpm run test && pnpm --filter m68k-lint test:coverage && pnpm --filter m68k-lint audit:impact",
    "typecheck": "tsc -b && pnpm -r run typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "build-docs": "scripts/conv-directives && scripts/conv-instructions",
    "package": "pnpm run package:extensions",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "build:formatter": "pnpm --filter m68k-formatter build",
    "build:assembly": "node scripts/build.mjs --minify",
    "test:assembly": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "package:counter": "pnpm --filter 68kcounter-vscode package",
    "check:packages": "node scripts/check-packages.mjs",
    "check:vasm": "node scripts/vasm/run.mjs",
    "test:extension-host": "pnpm --filter 68kcounter-vscode test:extension-host",
    "package:extensions": "pnpm run build && pnpm run package:assembly && pnpm run package:lint && pnpm run package:counter",
    "package:assembly": "pnpm --filter m68k-lsp package",
    "package:lint": "pnpm --filter m68k-lint-vscode package",
    "test:coverage:assembly": "vitest run --coverage",
    "publish:extensions": "node scripts/publish-extensions.mjs",
    "publish:assembly": "pnpm --filter m68k-lsp run publish",
    "publish:lint": "pnpm --filter m68k-lint-vscode run publish",
    "publish:counter": "pnpm --filter 68kcounter-vscode run publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.25.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx}": "eslint --cache --cache-location node_modules/.cache/eslint/",
    "*": "prettier --check --ignore-unknown"
  }
}
