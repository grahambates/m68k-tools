{
  "name": "m68k-tools",
  "version": "0.11.3",
  "private": true,
  "description": "Motorola 68000 assembly libraries, command-line tools and editor applications",
  "license": "MIT",
  "author": "Graham Bates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/workspace.mjs build",
    "build:dev": "node scripts/build.mjs --sourcemap",
    "watch": "node scripts/build.mjs --sourcemap --watch",
    "clean": "rm -rf packages/*/out packages/*/.tsbuild apps/m68k-lsp/wasm",
    "check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm --filter m68k-lint test:coverage && pnpm --filter m68k-lint audit:impact",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "lint": "node scripts/workspace.mjs lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node scripts/workspace.mjs test",
    "test:coverage": "vitest run --coverage",
    "build-docs": "scripts/conv-directives && scripts/conv-instructions",
    "package": "pnpm --filter m68k-lsp package",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "build:formatter": "pnpm --filter m68k-formatter build",
    "build:assembly": "node scripts/build.mjs --minify",
    "test:assembly": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "package:counter": "pnpm --filter 68kcounter-vscode package",
    "check:packages": "node scripts/check-packages.mjs",
    "test:extension-host": "pnpm --filter 68kcounter-vscode test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.25.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "prettier": "3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-import-resolver-typescript": "^4.4.5"
  },
  "packageManager": "pnpm@12.4.1"
}
