{
  "name": "68kcounter",
  "version": "5.1.0",
  "description": "68000 ASM source code cycle counter",
  "keywords": [
    "68000",
    "assembly",
    "asm",
    "optimization",
    "amiga",
    "commodore",
    "fs-uae",
    "win-uae"
  ],
  "scripts": {
    "test": "vitest run --config ../../vitest.package.config.mts",
    "lint": "pnpm --dir ../.. exec eslint packages/68kcounter",
    "build": "tsdown",
    "clean": "rm -rf out dist .tsbuild coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "main": "dist/index.js",
  "bin": {
    "68kcounter": "dist/cli.js"
  },
  "author": "Graham Bates <hello@grahambates.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "packages/68kcounter"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "tsdown": "0.23.0"
  },
  "dependencies": {
    "@types/yargs": "^17.0.24",
    "chalk": "^4.1.0",
    "m68k-parser": "workspace:^",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=22.15.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "images"
  ],
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./*": "./*",
    "./dist/*.js": "./dist/*.js",
    "./dist/*.mjs": "./dist/*.mjs",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*.d.mts": "./dist/*.d.mts",
    "./dist/*": "./dist/*.js",
    "./dist/parse": "./dist/parse/index.js",
    "./dist/sizes": "./dist/sizes/index.js",
    "./dist/timings": "./dist/timings/index.js"
  }
}
