{
  "name": "m68k-formatter",
  "version": "0.1.0",
  "description": "Motorola 68000 assembly formatter and CLI",
  "author": "Graham Bates",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.1"
  },
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "bin": {
    "m68k-format": "cli.js"
  },
  "files": [
    "out",
    "cli.js",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config ../../vitest.package.config.mts",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build"
  },
  "dependencies": {
    "m68k-parser": "workspace:^",
    "glob": "^13.0.6",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.0",
    "tsdown": "0.23.0",
    "vitest": "5.0.0"
  },
  "module": "out/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./out/index.d.mts",
        "default": "./out/index.mjs"
      },
      "require": {
        "types": "./out/index.d.ts",
        "default": "./out/index.js"
      }
    },
    "./*": "./*",
    "./out/*.js": "./out/*.js",
    "./out/*.mjs": "./out/*.mjs",
    "./out/*.d.ts": "./out/*.d.ts",
    "./out/*.d.mts": "./out/*.d.mts",
    "./out/*": "./out/*.js"
  }
}
