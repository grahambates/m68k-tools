{
  "name": "m68k-lint-langserver",
  "version": "0.3.0",
  "description": "Language server exposing m68k-lint diagnostics and quick fixes over LSP",
  "keywords": [
    "m68k",
    "68000",
    "68k",
    "assembly",
    "lint",
    "language-server",
    "lsp"
  ],
  "license": "MIT",
  "author": "Graham Bates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "packages/m68k-lint-langserver"
  },
  "engines": {
    "node": ">=22.15.1"
  },
  "bin": {
    "m68k-lint-langserver": "./out/server.js"
  },
  "main": "./out/server.js",
  "files": [
    "out",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "m68k-lint": "workspace:^",
    "@m68k-lsp/assembly-options": "workspace:^",
    "@m68k-lsp/workspace-files": "workspace:^"
  },
  "scripts": {
    "build": "node ../../scripts/build-lint-lsp.mjs --minify",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf out dist .tsbuild coverage"
  }
}
