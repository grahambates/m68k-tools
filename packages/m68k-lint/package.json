{
  "name": "m68k-lint",
  "version": "1.3.0",
  "description": "Extensible static analysis and linting for Motorola 68k assembly",
  "keywords": [
    "m68k",
    "68000",
    "68k",
    "motorola",
    "assembly",
    "asm",
    "lint",
    "linter",
    "static-analysis",
    "amiga",
    "atari-st",
    "optimization"
  ],
  "homepage": "https://github.com/grahambates/m68k-lint#readme",
  "bugs": {
    "url": "https://github.com/grahambates/m68k-lint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "packages/m68k-lint"
  },
  "author": "Graham Bates",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./project-config": {
      "types": "./dist/cli/project-config.d.ts",
      "import": "./dist/cli/project-config.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "m68k-lint.schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec eslint packages/m68k-lint",
    "lint:fix": "eslint . --fix",
    "format": "pnpm --dir ../.. run format",
    "format:check": "pnpm --dir ../.. run format:check",
    "cli": "node ./dist/cli/main.js",
    "audit:impact": "node ./dist/cli/main.js --audit-rule-impact",
    "verify:semantics": "pnpm run build && node --experimental-wasm-modules ./scripts/verify-semantics.mjs",
    "docs:rules": "pnpm run build && node ./scripts/generate-rules-doc.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build && pnpm run audit:impact",
    "clean": "rm -rf out dist .tsbuild coverage"
  },
  "dependencies": {
    "68kcounter": "workspace:^",
    "m68k-parser": "workspace:^"
  },
  "devDependencies": {
    "@specy/s68k": "^1.4.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "tsdown": "0.23.0"
  },
  "bin": {
    "m68k-lint": "./dist/cli/main.js"
  }
}
