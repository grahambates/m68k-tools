{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"]
}
