{
  "name": "m68k-lsp-server",
  "description": "Motorola 68000 assembly language server in node.",
  "version": "0.11.3",
  "author": "Graham Bates",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.1"
  },
  "bin": {
    "m68k-lsp-server": "cli.js"
  },
  "main": "out/server.js",
  "files": [
    "cli.js",
    "out",
    "wasm",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "packages/m68k-lsp-server"
  },
  "dependencies": {
    "m68k-parser": "workspace:^",
    "minimatch": "^10.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8",
    "which": "^4.0.0",
    "m68k-formatter": "workspace:^",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/which": "^3.0.4",
    "@m68k-lsp/protocol": "workspace:^"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs --minify",
    "test": "vitest run --config ../../vitest.package.config.mts",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf out dist .tsbuild coverage"
  }
}
