{
  "name": "m68k-parser",
  "version": "2.1.0",
  "description": "Motorola 68000 assembly parser",
  "author": "Graham Bates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "packages/m68k-parser"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "bin": {
    "m68k-parser": "cli.js"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "cli.js"
  ],
  "keywords": [
    "m68k",
    "68000",
    "motorola",
    "assembly",
    "parser",
    "assembler",
    "ast"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf out dist .tsbuild coverage",
    "test": "vitest run --config ../../vitest.package.config.mts",
    "lint": "pnpm --dir ../.. exec eslint packages/m68k-parser",
    "format": "pnpm --dir ../.. run format",
    "prepublishOnly": "pnpm run build && pnpm test",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "^0.25.11",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "tsdown": "0.23.0"
  },
  "engines": {
    "node": ">=22.15.1"
  }
}
